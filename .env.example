DATABASE_URL=postgres://postgres:postgres@postgres:5432/transcodex?sslmode=disable
REDIS_URL=redis://redis:6379
STORAGE_ENDPOINT=http://minio:9000
STORAGE_BUCKET=transcodex
# Leave storage keys unset in AWS when using an ECS task role.
STORAGE_ACCESS_KEY=transcodex
STORAGE_SECRET_KEY=transcodex-secret
CDN_BASE_URL=http://localhost:9000/transcodex
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:5173,http://127.0.0.1:5173
UPLOAD_PREFIX=raw
OUTPUT_PREFIX=outputs
OUTPUT_CACHE_CONTROL=public, max-age=86400, immutable
FFMPEG_PATH=ffmpeg
API_READ_HEADER_TIMEOUT_SECONDS=10
API_SHUTDOWN_TIMEOUT_SECONDS=10
UPLOAD_SIZE_LIMIT_BYTES=524288000
STATS_STREAM_INTERVAL_SECONDS=5
WORKER_MAX_RETRIES=3
WORKER_HEARTBEAT_INTERVAL=10
WORKER_POLL_BACKOFF_SECONDS=2
WORKER_LOCK_TTL_SECONDS=300
WORKER_SHUTDOWN_GRACE_SECONDS=30
REAPER_SWEEP_INTERVAL=30
REAPER_LEADERSHIP_LOCK_TTL_SECONDS=60
REAPER_DEAD_WORKER_THRESHOLD_SECONDS=30
REAPER_ORPHAN_JOB_THRESHOLD_SECONDS=300
REAPER_STALE_QUEUE_THRESHOLD_SECONDS=30
